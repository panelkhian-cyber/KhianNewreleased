--  PAGE (a single tab's content)
-- ============================================================
local Page = {}
Page.__index = Page

function Page:Section(title)
	local theme = KhianUI.Theme
	local holder = create("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		LayoutOrder = self._order, Parent = self.Frame,
	})
	self._order = self._order + 1
	create("Frame", {
		Size = UDim2.fromOffset(4, 16), Position = UDim2.fromOffset(0, 7),
		BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Parent = holder,
	})
	local accent = holder:FindFirstChildWhichIsA("Frame")
	corner(accent, 2)
	create("TextLabel", {
		Size = UDim2.new(1, -14, 1, 0), Position = UDim2.fromOffset(14, 0),
		BackgroundTransparency = 1, Font = theme.FontBold, Text = title,
		TextColor3 = theme.Text, TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
	})
	return holder
end

function Page:Label(text)
	local theme = KhianUI.Theme
	local lbl = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
		Font = theme.Font, Text = text, TextColor3 = theme.SubText,
		TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = self._order, Parent = self.Frame,
	})
	self._order = self._order + 1
	return lbl
end

function Page:Button(text, callback)
	local theme = KhianUI.Theme
	local btn = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = theme.Surface2,
		Text = "", AutoButtonColor = false, LayoutOrder = self._order, Parent = self.Frame,
	})
	self._order = self._order + 1
	corner(btn, 9)
	stroke(btn, theme.Stroke, 1, 0.3)
	local lbl = create("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Font = theme.FontBold, Text = text, TextColor3 = theme.Text,
		TextSize = 14, Parent = btn,
	})
	btn.MouseEnter:Connect(function() tween(btn, { BackgroundColor3 = theme.Accent }, 0.15) end)
	btn.MouseLeave:Connect(function() tween(btn, { BackgroundColor3 = theme.Surface2 }, 0.15) end)
	btn.MouseButton1Click:Connect(function()
		if callback then callback() end
	end)
	return btn
end

function Page:Toggle(text, default, callback)
	local theme = KhianUI.Theme
	local state = default == true
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = theme.Surface,
		LayoutOrder = self._order, Parent = self.Frame,
	})
	self._order = self._order + 1
	corner(row, 9)
	stroke(row, theme.Stroke, 1, 0.5)
	create("TextLabel", {
		Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1, Font = theme.Font, Text = text,
		TextColor3 = theme.Text, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local switch = create("TextButton", {
		Size = UDim2.fromOffset(44, 22), Position = UDim2.new(1, -56, 0.5, -11),
		BackgroundColor3 = state and theme.Good or theme.Surface2,
		Text = "", AutoButtonColor = false, Parent = row,
	})
	corner(switch, 11)
	local knob = create("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.fromOffset(3, 3),
		BackgroundColor3 = theme.Text, BorderSizePixel = 0, Parent = switch,
	})
	corner(knob, 8)
	switch.MouseButton1Click:Connect(function()
		state = not state
		tween(switch, { BackgroundColor3 = state and theme.Good or theme.Surface2 }, 0.18)
		tween(knob, { Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.fromOffset(3, 3) }, 0.18)
		if callback then callback(state) end
	end)
	return { Set = function(v)
		state = v == true
		switch.BackgroundColor3 = state and theme.Good or theme.Surface2
		knob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.fromOffset(3, 3)
	end }
end

function Page:Slider(text, min, max, default, callback)
	local theme = KhianUI.Theme
	min, max = min or 0, max or 100
	local value = default or min
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = theme.Surface,
		LayoutOrder = self._order, Parent = self.Frame,
	})
	self._order = self._order + 1
	corner(row, 9)
	stroke(row, theme.Stroke, 1, 0.5)
	create("TextLabel", {
		Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(12, 6),
		BackgroundTransparency = 1, Font = theme.Font, Text = text,
		TextColor3 = theme.Text, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local valueLbl = create("TextLabel", {
		Size = UDim2.new(0, 60, 0, 20), Position = UDim2.new(1, -72, 0, 6),
		BackgroundTransparency = 1, Font = theme.FontBold, Text = tostring(value),
		TextColor3 = theme.Accent2, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
	})
	local track = create("Frame", {
		Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 1, -16),
		BackgroundColor3 = theme.Surface2, BorderSizePixel = 0, Parent = row,
	})
	corner(track, 3)
	local fill = create("Frame", {
		Size = UDim2.fromScale((value - min) / math.max(1, (max - min)), 1),
		BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Parent = track,
	})
	corner(fill, 3)
	gradient(fill)
	local sliding = false

	local function apply(v, fire)
		v = math.clamp(math.floor(v + 0.5), min, max)
		value = v
		local alpha = (v - min) / math.max(1, (max - min))
		fill.Size = UDim2.fromScale(alpha, 1)
		valueLbl.Text = tostring(v)
		if fire and callback then callback(v) end
	end

	local function fromInput(input)
		local rel = (input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X)
		apply(min + (max - min) * math.clamp(rel, 0, 1), true)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			fromInput(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromInput(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	return { Set = function(v) apply(v, true) end, Get = function() return value end }
end

function Page:Dropdown(text, options, default, callback)
	local theme = KhianUI.Theme
	options = options or {}
	local current = default or options[1]
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = theme.Surface,
		LayoutOrder = self._order, Parent = self.Frame,
	})
	self._order = self._order + 1
	corner(row, 9)
	stroke(row, theme.Stroke, 1, 0.5)
	create("TextLabel", {
		Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(12, 6),
		BackgroundTransparency = 1, Font = theme.Font, Text = text,
		TextColor3 = theme.Text, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local button = create("TextButton", {
		Size = UDim2.new(1, -24, 0, 26), Position = UDim2.new(0, 12, 1, -32),
		BackgroundColor3 = theme.Surface2, Text = "", AutoButtonColor = false, Parent = row,
	})
	corner(button, 7)
	local buttonLbl = create("TextLabel", {
		Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1, Font = theme.Font, Text = tostring(current),
		TextColor3 = theme.Text, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = button,
	})
	create("TextLabel", {
		Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -24, 0.5, -10),
		BackgroundTransparency = 1, Font = theme.FontBold, Text = "v",
		TextColor3 = theme.SubText, TextSize = 12, Parent = button,
	})

	local open = false
	local panel = create("Frame", {
		Size = UDim2.new(1, -24, 0, #options * 26),
		Position = UDim2.new(0, 12, 1, -32 + 28),
		BackgroundColor3 = theme.Surface2, Visible = false, ZIndex = 5, Parent = row,
	})
	corner(panel, 7)
	stroke(panel, theme.Stroke, 1, 0.2)
	list(panel, 0)

	for _, opt in ipairs(options) do
		local optBtn = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = theme.Surface2,
			Text = "", AutoButtonColor = false, ZIndex = 6, Parent = panel,
		})
		create("TextLabel", {
			Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(10, 0),
			BackgroundTransparency = 1, Font = theme.Font, Text = tostring(opt),
			TextColor3 = theme.Text, TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = optBtn,
		})
		optBtn.MouseEnter:Connect(function() optBtn.BackgroundColor3 = theme.Accent end)
		optBtn.MouseLeave:Connect(function() optBtn.BackgroundColor3 = theme.Surface2 end)
		optBtn.MouseButton1Click:Connect(function()
			current = opt
			buttonLbl.Text = tostring(opt)
			open = false
			panel.Visible = false
			if callback then callback(opt) end
		end)
	end

	button.MouseButton1Click:Connect(function()
		open = not open
		panel.Visible = open
	end)

	return { Get = function() return current end }
end

function Page:Textbox(text, default, callback)
	local theme = KhianUI.Theme
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = theme.Surface,
		LayoutOrder = self._order, Parent = self.Frame,
	})
	self._order = self._order + 1
	corner(row, 9)
	stroke(row, theme.Stroke, 1, 0.5)
	create("TextLabel", {
		Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(12, 6),
		BackgroundTransparency = 1, Font = theme.Font, Text = text,
		TextColor3 = theme.Text, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local box = create("TextBox", {
		Size = UDim2.new(1, -24, 0, 26), Position = UDim2.new(0, 12, 1, -32),
		BackgroundColor3 = theme.Surface2, Font = theme.Font, Text = default or "",
		PlaceholderText = "...", TextColor3 = theme.Text, PlaceholderColor3 = theme.SubText,
		TextSize = 13, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	corner(box, 7)
	pad(box, 8)
	box.FocusLost:Connect(function()
		if callback then callback(box.Text) end
	end)
	return box
end

-- ============================================================
--  WINDOW
-- ============================================================
function KhianUI.new(config)
	config = config or {}
	local self = setmetatable({}, KhianUI)
	self.Config = {
		Title    = config.Title or "khian",
		Logo     = config.Logo or "KhxXn",
		Subtitle = config.Subtitle or "UI Library",
		Size     = config.Size or UDim2.fromOffset(560, 400),
		ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift,
	}
	self.Tabs = {}
	self._order = 0
	self:Build()
	return self
end

function KhianUI:Build()
	local theme = KhianUI.Theme
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")

	local screen = create("ScreenGui", {
		Name = "KhianUI", ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true,
		Parent = playerGui,
	})
	self.ScreenGui = screen

	local main = create("Frame", {
		Name = "Main", Size = self.Config.Size,
		Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = theme.Background, BorderSizePixel = 0, Parent = screen,
	})
	corner(main, 14)
	stroke(main, theme.Stroke, 1, 0.2)
	self.Main = main

	-- Title bar
	local titleBar = create("Frame", {
		Name = "TitleBar", Size = UDim2.new(1, 0, 0, 48),
		BackgroundColor3 = theme.Surface, BorderSizePixel = 0, Parent = main,
	})
	corner(titleBar, 14)
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -14),
		BackgroundColor3 = theme.Surface, BorderSizePixel = 0, Parent = titleBar,
	})
	local accent = create("Frame", {
		Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Parent = titleBar,
	})
	gradient(accent)

	local logo = create("TextLabel", {
		Name = "Logo", Size = UDim2.fromOffset(96, 48), Position = UDim2.fromOffset(14, 0),
		BackgroundTransparency = 1, Font = theme.FontBold, Text = self.Config.Logo,
		TextColor3 = theme.Text, TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = titleBar,
	})
	gradient(logo)

	create("TextLabel", {
		Size = UDim2.new(0, 220, 1, 0), Position = UDim2.fromOffset(112, 0),
		BackgroundTransparency = 1, Font = theme.Font, Text = self.Config.Subtitle,
		TextColor3 = theme.SubText, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = titleBar,
	})

	local close = create("TextButton", {
		Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -36, 0.5, -13),
		BackgroundColor3 = theme.Surface2, Text = "", AutoButtonColor = false, Parent = titleBar,
	})
	corner(close, 7)
	create("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = theme.FontBold,
		Text = "x", TextColor3 = theme.Text, TextSize = 14, Parent = close,
	})
	close.MouseEnter:Connect(function() close.BackgroundColor3 = theme.Bad end)
	close.MouseLeave:Connect(function() close.BackgroundColor3 = theme.Surface2 end)
	close.MouseButton1Click:Connect(function() screen.Enabled = false end)

	-- Dragging
	local dragging, dragStart, startPos
	local function update(input)
		local delta = input.Position - dragStart
		main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Sidebar + content
	local sidebar = create("Frame", {
		Name = "Sidebar", Size = UDim2.new(0, 150, 1, -76),
		Position = UDim2.fromOffset(14, 62), BackgroundTransparency = 1, Parent = main,
	})
	list(sidebar, 6)
	self.Sidebar = sidebar

	local content = create("Frame", {
		Name = "Content", Size = UDim2.new(1, -192, 1, -76),
		Position = UDim2.fromOffset(178, 62), BackgroundTransparency = 1, Parent = main,
	})
	self.Content = content

	-- Toggle key
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == self.Config.ToggleKey then
			screen.Enabled = not screen.Enabled
		end
	end)

	-- Notification layer
	self.NotifyLayer = create("Frame", {
		Name = "Notifications", Size = UDim2.new(0, 300, 1, -40),
		Position = UDim2.new(1, -320, 0, 20), BackgroundTransparency = 1,
		Parent = screen,
	})
	list(self.NotifyLayer, 8)
	create("UIListLayout", {
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Top, Parent = self.NotifyLayer,
	})
end

function KhianUI:Tab(name)
	local theme = KhianUI.Theme
	local button = create("TextButton", {
		Name = name, Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = theme.Accent, BackgroundTransparency = 1,
		Text = "", AutoButtonColor = false, Parent = self.Sidebar,
	})
	corner(button, 8)
	local bar = create("Frame", {
		Size = UDim2.fromOffset(3, 0), Position = UDim2.fromOffset(0, 0),
		BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Parent = button,
	})
	corner(bar, 2)
	local label = create("TextLabel", {
		Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(14, 0),
		BackgroundTransparency = 1, Font = theme.Font, Text = name,
		TextColor3 = theme.SubText, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = button,
	})

	local pageFrame = create("ScrollingFrame", {
		Name = name .. "Page", Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
		ScrollBarThickness = 3, CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollBarImageColor3 = theme.Stroke, Parent = self.Content,
	})
	list(pageFrame, 8)
	pad(pageFrame, 2)

	local page = setmetatable({ Frame = pageFrame, _order = 0 }, Page)

	local tab = { Button = button, Page = page, Frame = pageFrame }
	for _, fn in ipairs({ "Section", "Label", "Button", "Toggle", "Slider", "Dropdown", "Textbox" }) do
		tab[fn] = function(_, ...) return page[fn](page, ...) end
	end

	local function select()
		for _, other in ipairs(self.Tabs) do
			other.Frame.Visible = false
			other.Button.BackgroundTransparency = 1
			other.Bar.Size = UDim2.fromOffset(3, 0)
			other.Label.TextColor3 = theme.SubText
		end
		pageFrame.Visible = true
		button.BackgroundTransparency = 0.85
		bar.Size = UDim2.fromOffset(3, 18)
		label.TextColor3 = theme.Text
	end

	button.MouseButton1Click:Connect(select)
	button.MouseEnter:Connect(function()
		if not pageFrame.Visible then label.TextColor3 = theme.Text end
	end)
	button.MouseLeave:Connect(function()
		if not pageFrame.Visible then label.TextColor3 = theme.SubText end
	end)

	tab.Bar = bar
	tab.Label = label
	tab.Select = select
	table.insert(self.Tabs, tab)

	if #self.Tabs == 1 then
		select()
	end
	return tab
end

function KhianUI:Notify(title, text, duration)
	local theme = KhianUI.Theme
	duration = duration or 4
	local toast = create("Frame", {
		Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = theme.Surface,
		BackgroundTransparency = 1, BorderSizePixel = 0, Parent = self.NotifyLayer,
	})
	corner(toast, 10)
	stroke(toast, theme.Stroke, 1, 0.2)
	local accent = create("Frame", {
		Size = UDim2.fromOffset(4, 40), Position = UDim2.fromOffset(10, 10),
		BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Parent = toast,
