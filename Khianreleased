-- ============================================================
--  SECTION 1 — KhianUI (inlined module)
-- ============================================================
local KhianUI = (function()
--[[
	============================================================
	 KhianUI  —  a modern, dependency-free Roblox UI library
	 Brand : khian
	 Logo  : KhxXn
	------------------------------------------------------------
	 Build clean windows, tabs, toggles, sliders, dropdowns,
	 buttons, labels and toast notifications in a few lines.

	 Quick start:
	   local KhianUI = require(path.to.KhianUI)
	   local ui  = KhianUI.new({ Title = "khian", Logo = "KhxXn" })
	   local tab = ui:Tab("Home")
	   tab:Toggle("Some Feature", false, function(state) end)
	   ui:Notify("khian", "Loaded successfully!")

	 This library is intended for LEGITIMATE game development.
	============================================================
]]

local TweenService      = game:GetService("TweenService")
local UserInputService  = game:GetService("UserInputService")
local Players           = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

local KhianUI = {}
KhianUI.__index = KhianUI
KhianUI.Version = "1.0.0"

-- ============================================================
--  THEME
-- ============================================================
KhianUI.Theme = {
	Accent     = Color3.fromRGB(124, 92, 255),
	Accent2    = Color3.fromRGB(0, 214, 178),
	Background = Color3.fromRGB(16, 16, 22),
	Surface    = Color3.fromRGB(26, 26, 36),
	Surface2   = Color3.fromRGB(36, 36, 50),
	Text       = Color3.fromRGB(238, 238, 248),
	SubText    = Color3.fromRGB(150, 150, 172),
	Stroke     = Color3.fromRGB(52, 52, 72),
	Good       = Color3.fromRGB(64, 220, 132),
	Bad        = Color3.fromRGB(240, 92, 92),
	Font       = Enum.Font.GothamMedium,
	FontBold   = Enum.Font.GothamBold,
}

-- ============================================================
--  INTERNAL HELPERS
-- ============================================================
local function create(class, props)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(parent, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
	return create("UIStroke", {
		Color = color or KhianUI.Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		Parent = parent,
	})
end

local function pad(parent, px)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

local function list(parent, padding, dir)
	return create("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = dir or Enum.FillDirection.Vertical,
		Parent = parent,
	})
end

local function tween(inst, props, time)
	local t = TweenService:Create(inst, TweenInfo.new(time or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function gradient(inst, c1, c2)
	return create("UIGradient", {
		Color = ColorSequence.new(c1 or KhianUI.Theme.Accent, c2 or KhianUI.Theme.Accent2),
		Parent = inst,
	})
end

