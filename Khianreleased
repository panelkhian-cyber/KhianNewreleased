-- ============================================================
--  TWEEN HELPER
-- ============================================================
local TweenHelper = {}
KhianExtras.TweenHelper = TweenHelper

-- Friendly aliases so callers don't have to memorise the enums.
TweenHelper.Easing = {
	Linear  = Enum.EasingStyle.Linear,
	Sine    = Enum.EasingStyle.Sine,
	Quad    = Enum.EasingStyle.Quad,
	Cubic   = Enum.EasingStyle.Cubic,
	Quart   = Enum.EasingStyle.Quart,
	Quint   = Enum.EasingStyle.Quint,
	Bounce  = Enum.EasingStyle.Bounce,
	Elastic = Enum.EasingStyle.Elastic,
	Back    = Enum.EasingStyle.Back,
}

TweenHelper.Direction = {
	In    = Enum.EasingDirection.In,
	Out   = Enum.EasingDirection.Out,
	InOut = Enum.EasingDirection.InOut,
}

--[[
	TweenHelper.Tween(instance, properties, duration, style, direction)
	Generic wrapper around TweenService:Create. Returns the Tween.
]]
function TweenHelper.Tween(instance, properties, duration, style, direction)
	local info = TweenInfo.new(
		duration or 0.25,
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out
	)
	local tween = TweenService:Create(instance, info, properties)
	tween:Play()
	return tween
end

--[[
	TweenHelper.TweenAsync(...)
	Same as Tween, but yields until the tween finishes.
]]
function TweenHelper.TweenAsync(instance, properties, duration, style, direction)
	local tween = TweenHelper.Tween(instance, properties, duration, style, direction)
	tween.Completed:Wait()
	return tween
end

-- Collect every transparency-bearing property on an instance so a fade
-- can cover frames, text, images and UIStrokes in one pass.
local function transparencyProps(inst)
	local props = {}
	if inst:IsA("GuiObject") then
		props.BackgroundTransparency = true
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		props.TextTransparency = true
		props.TextStrokeTransparency = true
	end
	if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		props.ImageTransparency = true
	end
	if inst:IsA("UIStroke") then
		props.Transparency = true
	end
	return props
end

local function collectFadeTargets(root, includeDescendants)
	local targets = {}
	local function add(inst)
		local props = transparencyProps(inst)
		if next(props) then
			targets[#targets + 1] = { inst = inst, props = props }
		end
	end
	add(root)
	if includeDescendants ~= false then
		for _, d in ipairs(root:GetDescendants()) do
			add(d)
		end
	end
	return targets
end

-- Remember each element's natural ("visible") transparency the first
-- time it is faded, so a fade-in restores the ORIGINAL look instead of
-- forcing everything opaque. Weak keys let destroyed instances be GC'd.
local fadeBaselines = setmetatable({}, { __mode = "k" })

local function baselineFor(entry)
	local base = fadeBaselines[entry.inst]
	if not base then
		base = {}
		for prop in pairs(entry.props) do
			base[prop] = entry.inst[prop]
		end
		fadeBaselines[entry.inst] = base
	end
	return base
end

--[[
	TweenHelper.FadeIn(gui, duration, includeDescendants)
	Fades a GuiObject (and, by default, its descendants) in from fully
	transparent to their natural, visible transparency.
]]
function TweenHelper.FadeIn(gui, duration, includeDescendants)
	duration = duration or 0.35
	local targets = collectFadeTargets(gui, includeDescendants)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local last
	for _, entry in ipairs(targets) do
		local base = baselineFor(entry)
		local to = {}
		for prop in pairs(entry.props) do
			pcall(function() entry.inst[prop] = 1 end)
			to[prop] = base[prop] or 0
		end
		local tween = TweenService:Create(entry.inst, info, to)
		tween:Play()
		last = tween
	end
	return last
end

--[[
	TweenHelper.FadeOut(gui, duration, includeDescendants)
	Fades a GuiObject (and descendants) out to fully transparent. The
	natural transparency is remembered so FadeIn can restore it later.
]]
function TweenHelper.FadeOut(gui, duration, includeDescendants)
	duration = duration or 0.35
	local targets = collectFadeTargets(gui, includeDescendants)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local last
	for _, entry in ipairs(targets) do
		baselineFor(entry) -- capture before hiding
		local to = {}
		for prop in pairs(entry.props) do
			to[prop] = 1
		end
		local tween = TweenService:Create(entry.inst, info, to)
		tween:Play()
		last = tween
	end
	return last
end

--[[
	TweenHelper.ClearFadeBaseline(gui, includeDescendants)
	Forgets stored baselines so the next fade re-captures the current
	look (useful if you restyled the UI at runtime).
]]
function TweenHelper.ClearFadeBaseline(gui, includeDescendants)
	local targets = collectFadeTargets(gui, includeDescendants)
	for _, entry in ipairs(targets) do
		fadeBaselines[entry.inst] = nil
	end
end

--[[
	TweenHelper.SlideIn(gui, offset, duration, style)
	Slides a GuiObject into place from an offset (default: 40px from
	the right). Remembers the element's current position as the target.
]]
function TweenHelper.SlideIn(gui, offset, duration, style)
	offset = offset or UDim2.fromOffset(40, 0)
	local final = gui.Position
	gui.Position = final + offset
	return TweenHelper.Tween(
		gui,
		{ Position = final },
		duration or 0.3,
		style or Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	)
end

--[[
	TweenHelper.Pulse(gui, scale, duration)
	Quickly scales a GuiObject up then back — nice for button feedback.
]]
function TweenHelper.Pulse(gui, scale, duration)
	scale = scale or 1.06
	duration = duration or 0.12
	local final = gui.Size
	local up = UDim2.new(
		final.X.Scale * scale, final.X.Offset,
		final.Y.Scale * scale, final.Y.Offset
	)
	local t1 = TweenHelper.Tween(gui, { Size = up }, duration)
	t1.Completed:Wait()
	return TweenHelper.Tween(gui, { Size = final }, duration)
end

--[[
	TweenHelper.Shake(gui, magnitude, duration)
	Jitters a GuiObject left/right a few times, then restores it.
]]
function TweenHelper.Shake(gui, magnitude, duration)
	magnitude = magnitude or 6
	duration = duration or 0.3
	local final = gui.Position
	local steps = 6
	local info = TweenInfo.new(duration / steps, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	return task.spawn(function()
		for i = 1, steps do
			local dir = (i % 2 == 0) and 1 or -1
			local t = TweenService:Create(gui, info, { Position = final + UDim2.fromOffset(magnitude * dir, 0) })
			t:Play()
			t.Completed:Wait()
		end
		TweenHelper.Tween(gui, { Position = final }, duration / steps)
	end)
end

--[[
	TweenHelper.TweenCFrame(part, targetCFrame, duration, style, direction)
	Tweens a single BasePart's CFrame. Great for moving props,
	platforms or camera rigs.
]]
function TweenHelper.TweenCFrame(part, targetCFrame, duration, style, direction)
	return TweenHelper.Tween(
		part,
		{ CFrame = targetCFrame },
		duration or 1,
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out
	)
end

--[[
	TweenHelper.TweenModel(model, targetCFrame, duration, style, direction)
	Tweens an entire Model (or single BasePart) to a target CFrame by
	animating a proxy CFrameValue and re-pivoting every step. Works for
	props, NPCs, cutscene rigs, and your own character in places you own.
]]
function TweenHelper.TweenModel(model, targetCFrame, duration, style, direction)
	local proxy = Instance.new("CFrameValue")
	proxy.Value = model:GetPivot()

	local connection = proxy:GetPropertyChangedSignal("Value"):Connect(function()
		model:PivotTo(proxy.Value)
	end)

	local info = TweenInfo.new(
		duration or 1,
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out
	)
	local tween = TweenService:Create(proxy, info, { Value = targetCFrame })
	tween:Play()

	tween.Completed:Connect(function()
		connection:Disconnect()
		proxy:Destroy()
	end)

	return tween
end

--[[
	TweenHelper.SpinModel(model, degrees, duration, style, direction)
	Rotates a model around its own vertical (Y) axis. Defaults to one
	full 360° turn.
]]
function TweenHelper.SpinModel(model, degrees, duration, style, direction)
	local pivot = model:GetPivot()
	local target = pivot * CFrame.Angles(0, math.rad(degrees or 360), 0)
	return TweenHelper.TweenModel(model, target, duration or 1, style, direction)
end

--[[
	TweenHelper.MoveModelBy(model, offset, duration, style, direction)
	Moves a model by a relative Vector3 offset.
]]
function TweenHelper.MoveModelBy(model, offset, duration, style, direction)
	local target = model:GetPivot() + offset
	return TweenHelper.TweenModel(model, target, duration, style, direction)
end

--[[
	TweenHelper.TweenCharacter(targetCFrame, duration, style, direction)
	Convenience wrapper that tweens the LOCAL player's character. Best
	used in your own experience (spawn animations, cutscenes). While a
	Humanoid is actively simulating, physics may fight the tween — anchor
	the humanoid or use it for cosmetic spins/hops.
]]
function TweenHelper.TweenCharacter(targetCFrame, duration, style, direction)
	local character = LocalPlayer.Character
	if not character then
		return nil
	end
	return TweenHelper.TweenModel(character, targetCFrame, duration, style, direction)
end

-- ============================================================
--  IDLE INDICATOR
-- ============================================================
--[[
	Measures local inactivity. It listens to real input events and
	never synthesises input, so it cannot be used to defeat a game's
	anti-idle logic — it simply reports the player's idle time.
]]
local IdleIndicator = {}
IdleIndicator.__index = IdleIndicator
KhianExtras.IdleIndicator = IdleIndicator

--[[
	IdleIndicator.new(config)
	  config.IdleThreshold  (number, seconds before considered idle; default 60)
	  config.UpdateInterval (number, seconds between Tick callbacks; default 1)
	  config.OnIdle(idleTime)         fired once when the player becomes idle
	  config.OnActive()               fired once when the player returns
	  config.OnTick(idleTime, isIdle) fired every UpdateInterval
]]
function IdleIndicator.new(config)
	config = config or {}
	local self = setmetatable({}, IdleIndicator)
	self.IdleThreshold  = config.IdleThreshold or 60
	self.UpdateInterval = config.UpdateInterval or 1
	self.OnIdle   = config.OnIdle
	self.OnActive = config.OnActive
	self.OnTick   = config.OnTick

	self._lastActive = os.clock()
	self._idle = false
	self._running = false
	self._accum = 0
	self._connections = {}
	return self
end

-- Seconds since the last observed input.
function IdleIndicator:GetIdleTime()
	return os.clock() - self._lastActive
end

function IdleIndicator:IsIdle()
	return self:GetIdleTime() >= self.IdleThreshold
end

-- Call manually to reset the timer (e.g. after a scripted action).
function IdleIndicator:MarkActive()
	self._lastActive = os.clock()
	if self._idle then
		self._idle = false
		if self.OnActive then
			self.OnActive()
		end
	end
end

function IdleIndicator:Start()
	if self._running then
		return self
	end
	self._running = true
	self._lastActive = os.clock()

	local function bump()
		self:MarkActive()
	end

	table.insert(self._connections, UserInputService.InputBegan:Connect(bump))
	table.insert(self._connections, UserInputService.InputChanged:Connect(bump))
	table.insert(self._connections, UserInputService.InputEnded:Connect(bump))

	table.insert(self._connections, RunService.Heartbeat:Connect(function(dt)
		self._accum = self._accum + dt
		if self._accum < self.UpdateInterval then
			return
		end
		self._accum = 0

		local idleTime = self:GetIdleTime()
		if not self._idle and idleTime >= self.IdleThreshold then
			self._idle = true
			if self.OnIdle then
				self.OnIdle(idleTime)
			end
		end
		if self.OnTick then
			self.OnTick(idleTime, self._idle)
		end
	end))

	return self
end

function IdleIndicator:Stop()
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	self._connections = {}
	self._running = false
	return self
end

function IdleIndicator:IsRunning()
	return self._running
end

return KhianExtras

end)()

